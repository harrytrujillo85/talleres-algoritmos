Algoritmo valormayor_valorMenor
	Definir  num1, num2 Como Real
	Escribir "vamos a hayar el numero mayor y el menor"
	Escribir "digita el primer numero"
	Leer num1
	Escribir "digita el segundo numero"
	Leer num2
	
	Si num1 > num2 Entonces
		Escribir "el numero ", num1 , " es mayor"
		Escribir "el numero ", num2 , " es menor"
		
	SiNo
		Escribir "el numero ", num1 , " es menor"
		Escribir "el numero ", num2 , " es mayor"
		
	Fin Si
FinAlgoritmo
