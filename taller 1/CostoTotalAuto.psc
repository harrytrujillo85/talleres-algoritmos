Algoritmo CostoTotalAuto
    Definir precio, ganancias, impuesto, total Como Real
    precio = 35000000
    ganancias = precio * 12 / 100
    impuesto = precio * 6 / 100
    total = precio + ganancias + impuesto
    Escribir "El precio del vehiculo es ", precio
    Escribir "El porcentaje de ganancias es ", ganancias
    Escribir "El porcentaje de impuestos es ", impuesto
    Escribir "En este caso el costo total del vehiculo seria ", total
FinAlgoritmo

